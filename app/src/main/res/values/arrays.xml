  <string-array name="subtitle_search_values">
    <item>off</item>
    <item>first</item>
    <item>none</item>
  </string-array>

  <!-- When the second subtitle line is drawn. "Off" takes the whole feature away rather than just the
       line, and "on demand" is what the line was made for: the original read on its own, the hint
       asked for in the one moment a phrase did not land. -->
  <string-array name="subtitle_secondary_mode_entries">
    <item>@string/pref_subtitle_secondary_mode_off</item>
    <item>@string/pref_subtitle_secondary_mode_always</item>
    <item>@string/pref_subtitle_secondary_mode_demand</item>
  </string-array>

  <string-array name="subtitle_secondary_mode_values">
