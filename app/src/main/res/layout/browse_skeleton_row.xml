<?xml version="1.0" encoding="utf-8"?>
<!--
    A row before it has anything in it: the still's 96 x 54, a long line where the name goes and a
    short one where the metadata does. Every measurement here is browse_row.xml's - if that row
    changes shape, this one has to be changed with it, which is the price of a skeleton that is not
    the row itself.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <View
        android:id="@+id/browse_skeleton_frame"
        android:layout_width="96dp"
        android:layout_height="54dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_skeleton_block" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Two lines, the second shorter than the first, because that is what a name over a line of
             metadata looks like. The weights are what make them a proportion of the row rather than a
             width in dp that would be most of a narrow window and a stub of a wide one. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="13dp"
                android:layout_weight="7"
                android:background="@drawable/bg_skeleton_block" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="3" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="11dp"
                android:layout_weight="4"
                android:background="@drawable/bg_skeleton_block" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="6" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
