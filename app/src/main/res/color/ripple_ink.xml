<?xml version="1.0" encoding="utf-8"?>
<!-- The same press tone as @color/ripple_chrome and for the same reason, but keyed to the accent's INK
     rather than to colorPrimary. Chrome and a card want different tones of the accent — the ink over
     video, the fill on a light card — and colorPrimary answers whichever of the two its window is. So a
     chrome-coloured surface that happens to live inside the settings window (the About block's wash,
     the only one there is) asked for the chrome ripple and got the card's: in the light appearance that
     is Everforest's #849701 at 0.2 over a #303725 ground, which is no visible answer to a press at all.
     accentInk is the same value in both overlay variants, which is exactly what a chrome tone needs. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="?attr/accentInk" android:alpha="0.2" />
</selector>
