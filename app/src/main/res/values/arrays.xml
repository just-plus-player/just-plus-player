    <item>@string/pref_subtitle_color_white</item>
    <item>@string/pref_subtitle_color_blue</item>
  </string-array>

  <!-- Black, white and blue are the colours the system captioning presets used, so white on black,
       black on white, yellow on black and yellow on blue can all be set here. -->
  <string-array name="subtitle_background_values">
    <item>#00000000</item>
    <item>#80000000</item>
    <item>#FF000000</item>
    <item>#FFFFFFFF</item>
    <item>#FF0000FF</item>
  </string-array>

