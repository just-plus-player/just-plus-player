<?xml version="1.0" encoding="utf-8"?>
<!-- The same screen where the window is wider than it is tall - a phone sideways, a tablet, a
     television: the same card, centred, five sixths of the width (weights 1 : 10 : 1), so a card on a
     960dp set is a column and not a slab - and so its two inner columns are wide enough that a device
     name does not wrap, which on a 360dp phone turned sideways is what decided whether the card fit. The card's centre is the screen's centre - its actions live
     inside it, so there is nothing beside it to pull the mass off axis. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/error_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationContentDescription="@string/error_close"
        app:navigationIcon="@drawable/ic_arrow_back_24dp"
        app:navigationIconTint="?attr/colorOnSurface"
        app:title="@string/report_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/reportCard"
                layout="@layout/report_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="10" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
