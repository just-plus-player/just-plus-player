<?xml version="1.0" encoding="utf-8"?>
<!-- The upload action on a television: a lettered pill, not the 48dp glyph the phone shows. Copy and
     Share are hidden on a box (nothing there can paste or receive), so this is the only control on the
     card, and alone at glyph size it read as an afterthought at three metres. Same id, same three states
     - the label follows them (ErrorActivity.label) and the icon turns into a ring while the report is in
     flight. See layout/report_upload_button.xml for the phone's. -->
<com.google.android.material.button.MaterialButton
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/btnUpload"
    style="@style/Widget.JustPlus.Button.Filled"
    android:layout_width="wrap_content"
    android:layout_height="56dp"
    android:contentDescription="@string/error_upload"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:text="@string/error_upload"
    android:textSize="18sp"
    app:icon="@drawable/ic_cloud_upload_24dp"
    app:iconPadding="12dp"
    app:iconSize="24dp" />
