  <!-- The five steps the system captioning screen offered; normalizeFontScale maps them to the
       actual on-screen size, phones one notch bigger than TVs and tablets. -->
  <string-array name="subtitle_scale_entries">
    <item>@string/pref_subtitle_scale_smallest</item>
    <item>@string/pref_subtitle_scale_small</item>
    <item>@string/pref_subtitle_scale_normal</item>
