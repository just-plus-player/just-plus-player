<?xml version="1.0" encoding="utf-8"?>
<!-- The same block where the window is 600dp or wider - a phone held sideways, a tablet, a television.
     Stacked, it took 57% of a landscape phone's height and pushed what sits under it off the screen.
     Side by side it is a third of that, and the identity is centred against the report rather than
     hanging from its top edge. Restructured, not scaled. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.brouken.player.BrandWash
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <include
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            layout="@layout/preference_about_identity" />

        <include
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_weight="1"
            layout="@layout/preference_about_info" />

    </LinearLayout>

</FrameLayout>
