<!-- What a torrent is addressed by: a magnet, with the bolt of TorrServer's own mark flying off it.
     Drawn here rather than taken from anywhere - Material has no magnet, and a stock one carries a
     licence this app would then have to print. The horseshoe is the upright one (outer radius 8,
     wall 4, poles cut off with a 1.8 gap) turned a hundred and thirty-five degrees so its opening
     faces the corner, which is what frees the room the bolt needs; the bolt is Material's own, at a
     third of its size. Every number is on the group transforms, so the shapes themselves stay the
     simple ones that can be checked by eye. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:tint="#FFFFFF"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="-135"
        android:scaleX="0.78"
        android:scaleY="0.78"
        android:translateX="-1.4"
        android:translateY="1.6">
        <path
            android:fillColor="@android:color/white"
            android:pathData="M4,17 L4,11 A8,8 0 0,1 20,11 L20,17 L16,17 L16,11 A4,4 0 0,0 8,11 L8,17 Z" />
        <path
            android:fillColor="@android:color/white"
            android:pathData="M4,18.8 H8 V21.4 H4 Z M16,18.8 H20 V21.4 H16 Z" />
    </group>

    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="-60"
        android:scaleX="0.40"
        android:scaleY="0.40"
        android:translateX="5.9"
        android:translateY="-6.8">
        <group
            android:scaleX="0.025"
            android:scaleY="0.025"
            android:translateY="24">
            <path
                android:fillColor="@android:color/white"
                android:pathData="m320,-80 40,-280H160l360,-520h80l-40,320h240L400,-80h-80Z" />
        </group>
    </group>

</vector>
