<?xml version="1.0" encoding="utf-8"?>
<!-- The report as one object, shared by both arrangements: a heading, the short summary the caller
     supplied, a hairline, the lines that say what else the report carries, and the three actions on the
     card's own bottom edge - Material's card action row, trailing. Everything inside starts on one axis,
     16dp from the card's edge; nothing indents. One coloured thing on the card: the filled action.
     The lines are worked out from the text that is actually about to be sent, so a line here is never a
     promise the report does not keep. Once the report is up, the summary gives way to the link and its
     QR; the lines and the actions stay.
     The summary is neither focusable nor selectable: on a television that pulled the D-pad into the
     text with an invisible highlight and trapped it there (verified). Copying is the Copy button's job.
     Capped in lines rather than height so a long cause ends in an ellipsis - that something is missing
     is worth seeing, and the whole of it leaves by Copy, Share or the report itself. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_report_card"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Title Medium in the surface's ink: a card's headline, not a settings section header - the accent
         is spent on the one action below, and a coral label would take the eye first. -->
    <TextView
        android:id="@+id/reportHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/report_contents"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
        android:textColor="?attr/colorOnSurface" />

    <!-- Only when the caller can name the cause in words ("being decoded in software and cannot keep
         up"): the one line of copy on the screen, above the code it explains. Gone otherwise. -->
    <TextView
        android:id="@+id/errorMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        tools:text="HEVC 3840x2160 is being decoded in software on this device and cannot keep up." />

    <TextView
        android:id="@+id/errorDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:maxLines="@integer/report_summary_lines"
        android:textColor="?attr/colorOnSurface"
        android:textSize="13sp"
        tools:text="ERROR_CODE_IO_NETWORK_CONNECTION_FAILED\nUnable to resolve host" />

    <!-- The link and its code answer a tap by copying the link: on a phone the glyph that does the
         same thing says so only in a tooltip, and a link nobody can select is a link nobody can send. -->
    <LinearLayout
        android:id="@+id/uploadResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Drawn by Utils.qrBitmap, opaque black on white with its own two-module quiet zone, so the
             view adds no plate of its own. Encoded at the view's own pixel size, so nothing is scaled. -->
        <ImageView
            android:id="@+id/qrImage"
            android:layout_width="@dimen/report_qr_size"
            android:layout_height="@dimen/report_qr_size"
            android:contentDescription="@string/error_qr_description"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/uploadUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:focusable="false"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorPrimary"
            tools:text="https://termbin.com/abcd" />

        <TextView
            android:id="@+id/uploadHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/error_upload_hint"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:background="?attr/colorOutlineVariant" />

    <!-- No glyphs in front of the lines: a glyph column put a second left edge 40dp into the card with
         nothing above it to justify the gutter, and the lines read as indented by mistake. -->
    <TextView
        android:id="@+id/rowDevice"
        style="@style/ReportRow"
        tools:text="OnePlus CPH2447 · Android 15" />

    <TextView
        android:id="@+id/rowApp"
        style="@style/ReportRow"
        tools:text="Just+ Player 1.4.7" />

    <TextView
        android:id="@+id/rowPlayer"
        style="@style/ReportRow"
        android:text="@string/report_row_player" />

    <TextView
        android:id="@+id/rowLog"
        style="@style/ReportRow"
        tools:text="Log: 143 lines" />

    <!-- The card's actions, trailing, 8dp apart: copy and share keep the report on the device, the one
         that publishes it is filled and last. Gaps lead into the next button, so hiding Copy on a
         television - where a clipboard has no way out - leaves the other two where they were. -->
    <LinearLayout
        android:id="@+id/reportActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopy"
            style="@style/Widget.JustPlus.Button.Icon.Outlined"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/error_copy"
            app:icon="@drawable/ic_content_copy_24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShare"
            style="@style/Widget.JustPlus.Button.Icon.Outlined"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/error_share"
            app:icon="@drawable/ic_share_24dp" />

        <include layout="@layout/report_upload_button" />

    </LinearLayout>

</LinearLayout>
