<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <color name="brand">#FFFE6F61</color>
    <!-- The mark's ramp (see design/just+.svg); the vector drawables carry these same two stops. -->
    <color name="brand_ramp_start">#FFFF6E3C</color>
    <color name="brand_ramp_end">#FFFF0D63</color>
    <!-- ONE accent for everything the app draws on a surface: a switch track, a checked segment, the
         chosen row of a picker, a glyph, a section header. One, because two made the switch visibly
         change colour between light and dark.

         Its lightness is not a preference, it is the only window that exists. To be a fill or a glyph
         at 3:1 it has to be darker than L=0.254 (else it vanishes on a white card) and lighter than
         L=0.143 (else it vanishes on a dark one). L=0.193 is the middle of that window: 3.75:1 on the
         light card, 3.78:1 on the dark one. @color/brand sits at L=0.333, above the window, which is
         why it measured 2.4:1 on white.

         Same hue as @color/brand, saturation eased to 0.65 — at this lightness the full saturation
         reads as fire engine rather than coral.

         What it cannot be is small text at 4.5:1 in BOTH schemes: that would need it darker than
         L=0.172 on white and lighter than L=0.204 on black, and those windows do not overlap. As a
         section header it lands at 4.11:1 light and 4.30:1 dark — short of AA, and still twice what
         the bright coral managed on white. -->
    <color name="brand_accent">#FFD6493C</color>
    <!-- Ink on that accent. White. WCAG 2 arithmetic prefers near-black here (4.88:1 against white's
         4.31:1), and that is the metric's known blind spot on a saturated mid-tone: perceptually (APCA)
         black reads Lc 35, short even of the large-text floor, where white reads Lc 74 and clears a
         14sp medium label. The eye agrees with APCA. The fill is not darkened to buy white the WCAG
         tick — that would cost the button its own edge against a dark dialog surface. -->
    <color name="brand_accent_on">@color/white</color>

    <!-- M3 primary container (switch track when on, tonal surfaces): the brand at container tone.
         One value for both day and night — a deep coral reads on white and on the dark settings list alike.
         The player's current picker row takes it too, so a selected row and a switch that is on are the
         same colour rather than two different dimmings of the same accent. -->
    <color name="brand_container">#FF7A2019</color>

    <!-- The mark's plum, the ground the app gives itself where it speaks for itself: the empty state,
         the error screen, the About block. Named here because three places draw it. -->

    <!-- The launcher icon's own ground, a shade under the wash's plum. Named because the About block
         draws the same tile the launcher does. -->
    <color name="app_icon_ground">#FF150B33</color>

    <!-- The flag, at its published values. A badge rather than a palette entry: nothing else in the
         app reads these, and nothing else should. -->
    <color name="ua_blue">#FF0057B7</color>
    <color name="ua_yellow">#FFFFD700</color>
    <!-- M3 on-primary: the ink that sits on the brand, e.g. the switch handle when it is on. -->
    <color name="brand_on">#FF5F1411</color>

    <!-- The other 30 accent themes are not colour names at all: their values live in
         themes_accents.xml, generated by feature/accent-themes/palette.py, and are read as roles
         through ?attr/accent* (attrs.xml). The picker paints each tile from the overlay style's own
         attributes, so nothing here has to name a swatch. The coral above stays, because it is the
         brand as well as a theme and the base themes carry it as their default. -->

    <!-- AMOLED: the card tone over a pure black window, still a shade above it so cards read as cards. -->
    <color name="amoled_card">#FF141416</color>

    <color name="shortcut_background">#F5F5F5</color>

    <!-- Error screen (ErrorActivity): a calm dark surface, not an alarming full-red state. -->
    <color name="error_surface">#FF1B1B21</color>
    <color name="error_stroke">#26FFFFFF</color>
    <color name="error_ink_muted">#FFC4C4CE</color>

    <!-- Full-frame dim behind the controls; fades with the controller via @id/exo_controls_background. -->
    <color name="controls_scrim">#66000000</color>

    <!-- Progress bar: the played run and its scrubber take the accent ink (?attr/colorPrimary in the
         player theme), the same tone as the Play glyph the bar sits under, over a solid dark rail ahead
         of the playhead (not a wash of the frame behind it). -->
    <color name="timebar_track">#FF38393C</color>

    <!-- Volume/brightness OSD bar (LevelBar); the boost segment is everything above 100%. -->
    <color name="level_bar_track">#4DFFFFFF</color>
    <color name="volume_boost">#FFF57C00</color>

    <!-- Player chrome ink. The player UI is built in code over video, so its text is white at an
         emphasis rather than a theme colour: the frame behind is unknown, and a theme's onSurface
         would be picked for a surface that isn't there. Named by the role, not by the alpha. -->
    <color name="ink_high">#E6FFFFFF</color>
    <color name="ink_clock">#C2FFFFFF</color>
    <color name="ink_medium">#B3FFFFFF</color>
    <color name="ink_secondary">#99FFFFFF</color>
    <color name="ink_tertiary">#80FFFFFF</color>
    <!-- A row that is not the current one: opaque grey, not white at an alpha, so it stays a step
         below the current row even where the fill behind them differs. -->
    <color name="ink_row_inactive">#FFDDDDDD</color>

    <!-- Player chrome surfaces, all translucent so the picture keeps showing through. Two families:
         a near-opaque one the panels and pills are cut from, and the plainly translucent black of
         @color/ui_controls_background further down. What used to be four names was two pairs 2/255 and
         1/255 apart — close enough that nothing could have been choosing between them on purpose. -->
    <color name="chrome_surface">#F0141414</color>
    <!-- The panels are Material detached side sheets: a card over a dimmed picture, so the tone is
         the chrome one at full opacity. Nothing shows through a sheet that has its own scrim. -->
    <color name="sheet_surface">#FF141414</color>
    <color name="badge_scrim">#CC000000</color>
    <color name="placeholder_card">#FF333333</color>
    <color name="thumb_box">#FF2A2A2A</color>

    <!-- Hairlines, grooves and the unfilled part of a track. -->
    <color name="divider">#1AFFFFFF</color>
    <color name="track_white">#33FFFFFF</color>
    <!-- Buffered lead ahead of the playhead; used on network sources only, see the call site. -->
    <color name="buffered_white">#C0FFFFFF</color>

    <!-- Press feedback is the accent at 0.20 — see res/color/ripple_chrome.xml. -->

    <!-- Segment highlights (see CustomDefaultTimeBar): a *_fill band across the segment plus a crisp
         boundary hairline in the lighter *_edge colour. Three-colour timeline system — the accent ink =
         playback, skip = a hue set against it, amber = ad. The skip band is the one meaning colour that
         rides on the accent (?attr/accentSkip), because it lies on the same rail as the played run and
         is told apart by hue.

         The hue is chosen, the chroma is not. Every colour on this bar sits at the edge of what sRGB
         can do at its own lightness: the coral ink is at 99 % of it, the amber at 100 %, the blue skip
         band at 99 %. So a band is built as "the most this hue can be at L 0.63–0.67", which is what
         makes it read as a marker instead of a wash — a fixed chroma across hues does not, since the
         gamut is 2.5× wider at magenta than at cyan (the first cut fixed C at 0.116 and came out at
         26 % and 39 % of the edge: visibly dull, and the owner said so).

         The hue is the middle of what is left of the circle after excluding 90° around the accent's
         own ink and 60° around the amber ad band (OKLCH hue 68); a grey ink has no hue to keep away
         from and takes this blue. One band per accent theme, derived and gated against the rail in
         feature/accent-themes/palette.py and written into themes_accents.xml; this is the coral's,
         and the default the base themes carry. The band is opaque, so it reads the same over played
         and unplayed track. -->
    <color name="skip_edge">#FFEAF6FF</color>
    <color name="skip_fill">#FF0696BB</color>
    <color name="ad_edge">#FFFFD27A</color>
    <color name="ad_fill">#C7FFA000</color>

    <!-- The translucent black chrome: the control cluster, the lock and stats pills, the round discs,
         swipe-to-unlock, the navigation bar, and the Media3 colours below that alias to it. 80%, not the
         60% it was: the plate now carries coloured ink (the hero's coral glyph, an on state) and a white
         focus contour, and at 60% it resolves to #676767 over a white frame, where brand is 2.06:1. At 80%
         it is #333333 there, and brand holds 4.61:1 on the brightest frame a picture can be. -->
    <color name="ui_controls_background">#CC000000</color>
    <color name="exo_bottom_bar_background" tools:keep="@color/exo_bottom_bar_background">@color/ui_controls_background</color>
    <color name="exo_black_opacity_70" tools:keep="@color/exo_black_opacity_70">@color/ui_controls_background</color>
    <color name="exo_styled_error_message_background" tools:keep="@color/exo_styled_error_message_background">@color/ui_controls_background</color>
</resources>