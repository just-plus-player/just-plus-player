    <item>0.5</item>
    <item>1.0</item>
    <item>1.5</item>
    <item>2.0</item>
  </string-array>

  <!-- White, yellow, cyan and green are the four the BBC subtitle guidelines recommend: picked for
       the distance between their luminances, not their hues. Soft white is there because plain white
       haloes on dark scenes. Red, blue and magenta exist in the broadcast palette and are left out —
       too dark to read over video. -->
  <string-array name="subtitle_text_color_entries">
    <item>@string/pref_subtitle_color_white</item>
    <item>@string/pref_subtitle_color_soft_white</item>
    <item>@string/pref_subtitle_color_yellow</item>
    <item>@string/pref_subtitle_color_cyan</item>
    <item>@string/pref_subtitle_color_green</item>
    <item>@string/pref_subtitle_color_black</item>
  </string-array>

  <string-array name="subtitle_text_color_values">
    <item>#FFFFFFFF</item>
    <item>#FFCCCCCC</item>
    <item>#FFFFFF00</item>
    <item>#FF00FFFF</item>
    <item>#FF00FF00</item>
    <item>#FF000000</item>
  </string-array>

