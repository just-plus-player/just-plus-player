<?xml version="1.0" encoding="utf-8"?>
<!-- The report screen, compact width (a phone upright): a bar with the way back, and the report card
     (report_card.xml) with its actions on its own bottom edge. Nothing else - no headline, no glyph, no
     explanation: the owner asked for the block gone, and a caller's name for the screen goes in the bar.
     The column scrolls rather than clips: at a large font scale or a long cause nothing is cut off.
     See layout-land for the wide arrangement. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/error_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationContentDescription="@string/error_close"
        app:navigationIcon="@drawable/ic_arrow_back_24dp"
        app:navigationIconTint="?attr/colorOnSurface"
        app:title="@string/report_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <include
                android:id="@+id/reportCard"
                layout="@layout/report_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
