<?xml version="1.0" encoding="utf-8"?>
<!-- The destinations, and only the destinations (R7): what the window changes is which surface lists
     them - the bar under 600dp, the rail from 600dp, the start page on a television. Anything that is
     a verb rather than a place lives in the toolbar's menu instead. -->
<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:id="@+id/dest_favorites"
        android:icon="@drawable/ic_star_24dp"
        android:title="@string/nav_favorites" />

    <item
        android:id="@+id/dest_files"
        android:icon="@drawable/ic_movie_24dp"
        android:title="@string/browse_title" />

    <item
        android:id="@+id/dest_network"
        android:icon="@drawable/ic_dns_24dp"
        android:title="@string/nav_network" />

    <!-- Hidden while it is being built: the page behind it says only "in development", and a
         destination that leads nowhere is not one. The item stays so the id and the code paths do,
         and showing it again is this one line. -->
    <item
        android:id="@+id/dest_iptv"
        android:icon="@drawable/ic_live_tv_24dp"
        android:title="@string/nav_iptv"
        android:visible="false" />

</menu>
