<?xml version="1.0" encoding="utf-8"?>
<!--
    The shell. One activity holding three destinations, and the window decides which surface lists
    them (R7): the bar below 600dp, the rail from 600dp, the start page on a television - where the
    two navigation surfaces are hidden and the cards do the job instead.

    The rail is a sibling of the content column rather than part of it, which is why the root is
    horizontal: a rail is docked to the window's edge, the same rule the player's panels follow.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/browse_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <!-- Labelled for the reason the bar below is, and a rail has the room: four glyphs in a column
         with one word under the chosen one is a column of three riddles.

         80dp is the floor and not the width: that is the column Material gives a collapsed rail, and
         pinning it there cut "Избранное" to "Изб..." on a telephone whose system font is wider than
         the one this was measured on. A label that cannot be read is worse than a column that is a
         few dp wider than the specification, so the column follows the longest label and never goes
         under the 80dp. -->
    <com.google.android.material.navigationrail.NavigationRailView
        android:id="@+id/browse_rail"
        android:layout_width="wrap_content"
        android:minWidth="80dp"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:contentMarginTop="0dp"
        app:itemTextAppearanceActive="@style/TextAppearance.JustPlus.NavLabel"
        app:itemTextAppearanceInactive="@style/TextAppearance.JustPlus.NavLabel"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/browse_nav" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- The header. No band: the window's ground runs from the status bar to the last row, and the
             screen's name is a 28sp headline standing on it - which is what Android 16 does in Settings,
             Files and Photos, and what this app carried a coloured 64dp strip for. The wrapper stays
             because the status bar inset goes on it: the toolbar is handed to AppCompat as the action
             bar, which manages its own padding and quietly puts back whatever is set on it. -->
        <LinearLayout
            android:id="@+id/browse_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/browse_toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:titleTextAppearance="@style/TextAppearance.JustPlus.ScreenTitle" />

        </LinearLayout>

        <!-- Where you are, one step per level, each step a way back to it. Scrolls sideways because a
             path is as long as it is, and carries no fading edge: the last crumb is the one you are in
             and it must not be the one that looks cut off. -->
        <HorizontalScrollView
            android:id="@+id/browse_crumbs_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/browse_crumbs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/browse_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <!-- Nothing to show, and why. Centred, because it is the whole page rather than a note on
                 one: an empty folder, a folder that was never granted, and a destination whose feature
                 is not built yet all land here. -->
            <LinearLayout
                android:id="@+id/browse_blank"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/browse_blank_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="?android:attr/textColorPrimary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/browse_blank_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?android:attr/textColorSecondary" />

                <!-- What can be added, on a page that says there is nothing here yet: three chips in the
                     row's own meta family, filled in code because a protocol is a name and not a
                     string to translate. Information, so nothing about them is pressable. -->
                <LinearLayout
                    android:id="@+id/browse_blank_tiles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:visibility="gone" />

                <!-- R4: an action carries its own frame, and R3 makes an action a pill. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/browse_blank_action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/browse_grant_access"
                    android:visibility="gone" />

            </LinearLayout>

            <include
                android:id="@+id/browse_home"
                layout="@layout/browse_home"
                android:visibility="gone" />

            <!-- What a folder looks like before it has been read: the rows, tiles or pair of columns
                 that are about to be there, drawn empty. Filled in code (BrowserActivity.raiseSkeleton)
                 because how many of them there are and what shape they take is the view the viewer
                 chose and the window it is shown in.

                 A listing that is over before the eye can follow it must not be announced at all: a
                 skeleton shown for a tenth of a second is a flash, and a flash reads as something going
                 wrong. So it waits a fifth of a second before appearing - on a folder the index answers for
                 (9ms measured on a phone, 239 files) it is never drawn, and what it is really for is a
                 share over SMB or a DLNA server thinking about it. -->
            <LinearLayout
                android:id="@+id/browse_skeleton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Labelled, and said out loud: Material's own default hides every unselected label once a
             bar carries four items, which is exactly when the labels start to matter - a star, a
             stack of discs and a television set are not three words anybody reads off a glyph. At
             411dp the four fit; Material carries labels to five. -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/browse_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:itemTextAppearanceActive="@style/TextAppearance.JustPlus.NavLabel"
            app:itemTextAppearanceInactive="@style/TextAppearance.JustPlus.NavLabel"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/browse_nav" />

    </LinearLayout>

</LinearLayout>
