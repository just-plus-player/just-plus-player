<?xml version="1.0" encoding="utf-8"?>
<!-- The running time, printed on the still itself. Over a picture there is no surface to belong to,
     so it carries the same scrim every badge over video in this app uses. 4dp, which is the scale's
     own smallest step: the 6dp it carried was off the scale entirely, on the most repeated element in
     the app. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="4dp" />
    <solid android:color="@color/badge_scrim" />
</shape>
