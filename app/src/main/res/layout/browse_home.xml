<?xml version="1.0" encoding="utf-8"?>
<!--
    The start page, and only on a television. A remote has no thumb to reach a bar with, so the set
    gets the showcase instead: the identity in one corner, the destinations as cards, and the two
    things that are not destinations as labelled pills under them - read from across a room, where a
    glyph in a toolbar cannot be.

    Flat, like the rest of the app: a card is colorSurfaceContainer on the window, the doorway glyphs
    take colorPrimary (DESIGN.md §7 - a list of doorways has no chosen row to keep the accent for),
    and focus is each card's own 2dp contour, drawn by Utils.pickerRow in code.

    Two kinds of thing, two treatments. The four destinations are cards; the gear and the two verbs
    share one neutral tonal body on colorSurfaceContainerHigh - they were dressed three ways, which is
    what made the verbs read as captions rather than as controls: the same ink on the same ground as
    the caption two lines above them, with nothing around them. Labels kept: on a ten-foot screen a
    glyph carries meaning only where the whole platform uses it that way, and a chain means "copy
    link" on Android while a watch party is a feature nobody expects.

    The numbers: 48dp band, the lockup at 48, cards 180 x 300dp at the 16dp corner a card 150dp or
    wider takes, the pills and the gear 48dp - 128 to 428 for the cards and 448 to 496 for the pills,
    inside a 540dp panel whose safe area ends at 513.

    Behind it all, @drawable/bg_home_beam: four cards take 768 of an 864dp band and the 96 left over
    read as a margin rather than as a hole. The beam stands in the corner under them - two flat
    wedges in the surface ramp, held clear of the cards, described where it is drawn. It was drawn
    for three cards and redrawn for the fourth; the arithmetic is in that file.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_beam"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="21dp"
    android:paddingEnd="48dp"
    android:paddingBottom="27dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/app_name"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="22sp" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_logo_mark" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- The lit ground is a box of its own, because a backgroundTint is one colour and the
             gradient is two; the button keeps its shape, its ripple and its focus contour on top of
             it with a tint of nothing. -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_gear_lit">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_settings"
                style="@style/Widget.JustPlus.Button.Tonal.Icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/pref_title"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:backgroundTint="@android:color/transparent"
                app:icon="@drawable/ic_settings_24dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp" />

        </FrameLayout>

    </LinearLayout>

    <!-- Tier one: the destinations. A rail rather than a grid, because the set grows as media servers
         and whatever follows them arrive. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/home_card_favorites"
            android:layout_width="180dp"
            android:layout_height="300dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_star_24dp"
                app:tint="?attr/colorPrimary" />

            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_favorites"
                android:textColor="?android:attr/textColorPrimary"
                android:fontFamily="sans-serif-medium"
            android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/home_favorites_caption"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="16sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_card_files"
            android:layout_width="180dp"
            android:layout_height="300dp"
            android:layout_marginStart="16dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_movie_24dp"
                app:tint="?attr/colorPrimary" />

            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/browse_title"
                android:textColor="?android:attr/textColorPrimary"
                android:fontFamily="sans-serif-medium"
            android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/home_files_caption"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="16sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_card_network"
            android:layout_width="180dp"
            android:layout_height="300dp"
            android:layout_marginStart="16dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_dns_24dp"
                app:tint="?attr/colorPrimary" />

            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_network"
                android:textColor="?android:attr/textColorPrimary"
                android:fontFamily="sans-serif-medium"
            android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/home_network_caption"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="16sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_card_iptv"
            android:visibility="gone"
            android:layout_width="180dp"
            android:layout_height="300dp"
            android:layout_marginStart="16dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_live_tv_24dp"
                app:tint="?attr/colorPrimary" />

            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_iptv"
                android:textColor="?android:attr/textColorPrimary"
                android:fontFamily="sans-serif-medium"
            android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/iptv_title"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="16sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Tier two: the verbs. Labelled, because a pill read at three metres is the whole point of the
         page; outlined, because the one filled control per surface is not spent here. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_link"
            style="@style/Widget.JustPlus.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/empty_state_link"
            android:fontFamily="sans-serif-medium"
            android:textSize="18sp"
            app:icon="@drawable/ic_link_24dp"
            app:iconPadding="10dp"
            app:iconSize="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_room"
            style="@style/Widget.JustPlus.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:minHeight="48dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/together_join"
            android:fontFamily="sans-serif-medium"
            android:textSize="18sp"
            app:icon="@drawable/ic_together_24dp"
            app:iconPadding="10dp"
            app:iconSize="24dp" />

    </LinearLayout>

</LinearLayout>
